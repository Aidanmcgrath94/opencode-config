{
  "plugin": [
    "./plugin/edit-error-recovery.ts",
    "./plugin/keyword-detector.ts",
    "./plugin/goal.ts",
    "./plugin/rules-injector.ts"
  ],
  "default_agent": "Sisyphus - Ultraworker",
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "Sisyphus - Ultraworker": {
      "description": "Powerful AI orchestrator. Plans obsessively with todos, assesses search complexity before exploration, delegates strategically via subagent selection and skill loading. Uses Explore - Codebase Search for internal code (parallel-friendly), Librarian - Docs Search for external docs.",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "prompt": "{file:./agent-prompts/sisyphus.md}"
    },
    "Prometheus - Plan Builder": {
      "description": "Planning consultant that turns a request into a single decision-complete work plan via the ulw-plan skill. Never implements directly - plan mode is sticky.",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "task": "allow"
      },
      "prompt": "{file:./agent-prompts/prometheus.md}"
    },
    "Atlas - Plan Executor": {
      "description": "Orchestrates work via the task tool to complete ALL tasks in a todo list until fully done, with rigorous manual verification and a Final Verification Wave.",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
      "prompt": "{file:./agent-prompts/atlas.md}"
    },
    "Explore - Codebase Search": {
      "description": "Contextual grep for codebases. Answers \"Where is X?\", \"Which file has Y?\", \"Find the code that does Z\". Fire multiple in parallel for broad searches. Specify thoroughness - \"quick\" for basic, \"medium\" for moderate, \"very thorough\" for comprehensive analysis.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/omo-explore.md}"
    },
    "Librarian - Docs Search": {
      "description": "Specialized codebase understanding agent for multi-repository analysis, searching remote codebases, retrieving official documentation, and finding implementation examples using GitHub CLI, Context7, and Web Search. Use when users ask to look up code in remote repositories, explain library internals, or find usage examples in open source.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/anthropic.claude-haiku-4-5-20251001-v1:0",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/omo-librarian.md}"
    },
    "Metis - Plan Consultant": {
      "description": "Pre-planning consultant that analyzes requests to identify hidden intentions, ambiguities, and AI failure points.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/metis.md}"
    },
    "Momus - Plan Critic": {
      "description": "Expert reviewer for evaluating work plans against rigorous clarity, verifiability, and completeness standards.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/momus.md}"
    },
    "Multimodal Looker - Vision": {
      "description": "Analyze media files (PDFs, images, diagrams) that require interpretation beyond raw text. Extracts specific information or summaries from documents, describes visual content. Use when you need analyzed/extracted data rather than literal file contents.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/multimodal-looker.md}"
    },
    "Oracle - Architecture Consult": {
      "description": "Read-only consultation agent. High-IQ reasoning specialist for debugging hard problems and high-difficulty architecture design.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/oracle.md}"
    },
    "Sisyphus-Junior": {
      "description": "Focused task executor. Same discipline as Sisyphus; delegates research to Explore/Librarian only, never spawns further executors.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
      "permission": {
        "task": {
          "*": "deny",
          "Explore - Codebase Search": "allow",
          "Librarian - Docs Search": "allow"
        }
      },
      "prompt": "{file:./agent-prompts/sisyphus-junior.md}"
    },
    "Daedalus - Problem Explorer": {
      "description": "Problem-exploration consultant that explores and problem-solves BEFORE planning, then hands a framed problem to Prometheus. Conversational-first, autonomous when helpful. Never plans, never implements. Drives the explore-solve skill.",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "allow"
      },
      "prompt": "{file:./agent-prompts/daedalus.md}"
    },
    "Hermes - PR & GitHub Delivery": {
      "description": "Delivery agent that owns the PR lifecycle (gh pr create/update/merge) and GitHub operations via the github MCP. Defers local commit/rebase/history to the git-master skill; operates only from the task-owned worktree after gates pass. Read-only to the filesystem.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/hermes.md}"
    },
    "Nemesis - Security Reviewer": {
      "description": "Read-only, one-shot code security reviewer. Audits a diff/changed files against a 10-point security checklist and returns a structured PASS/FAIL verdict with severity. Security only - not style, architecture, or plan review.",
      "mode": "subagent",
      "hidden": true,
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      },
      "prompt": "{file:./agent-prompts/nemesis.md}"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--isolated"],
      "environment": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
